# Optional. Copy to .env.local only to override a default; you don't need it to run the app.
# Values in .env.local win over the code defaults, but a variable already set in the shell wins over both.

# Server-only URL Next.js uses to reach the backend. Default: src/lib/backend-url.ts
# BACKEND_URL=http://localhost:8000

# Shared secret the backend sends to /api/revalidate. Must match the backend's REVALIDATE_SECRET.
# Unset or empty rejects every call. The devcontainer sets a dev-only value in
# .devcontainer/docker-compose.yml.
# REVALIDATE_SECRET=

# Self-hosted Umami page views. Set both values at build and runtime to enable analytics.
# Serve Umami on a separate origin so collection requests only receive the public site origin.
# Keep IP logging disabled on the Umami service and its reverse proxy.
# WEBSITE_ANALYTICS_SCRIPT_URL=https://analytics.example.com/script.js
# WEBSITE_ANALYTICS_SITE_ID=

# Website analytics dashboard (#164), linked from /portal/admin/analytics. Unset hides the link.
# Inlined into the browser bundle at build time.
# NEXT_PUBLIC_WEBSITE_ANALYTICS_URL=
