# Optional. Copy to .env only to override a default; you don't need it to run the app.
# Values in .env win over the code defaults, but a variable already set in the shell wins over both.
# Never commit .env.

# Defaults: app/config.py
# ENVIRONMENT=development
# DATABASE_URL=postgresql+psycopg://postgres:postgres@db:5432/peer2peer
# TEST_DATABASE_URL=postgresql+psycopg://postgres:postgres@db:5432/peer2peer_test
# CORS_ORIGINS=["http://localhost:3000"]
# LINE_TIMEZONE=America/New_York
# SESSION_IDLE_MINUTES=30
# SESSION_MAX_HOURS=12
# The devcontainer sets this to false so session cookies work over local http.
# SESSION_COOKIE_SECURE=true

# Required, no code default. The devcontainer sets dev-only values in .devcontainer/docker-compose.yml,
# and those win over this file. Outside the devcontainer, set them here.
# Generate a key: python -c "import base64, os; print(base64.b64encode(os.urandom(32)).decode())"
# MESSAGE_KEYS={"1": "<base64 32-byte key>"}
# ESCALATION_KEYS={"1": "<base64 32-byte key>"}
